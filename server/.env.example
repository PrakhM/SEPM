# ---- FinTrack server env template ----
# Copy to .env and fill in real values. Never commit .env.

# Pooled connection string (PgBouncer) - used by the app at runtime.
DATABASE_URL=

# Direct connection string - used only for `npx prisma migrate dev/deploy`.
DIRECT_URL=

# Secret used to sign JWT access tokens. Use a long random string.
JWT_SECRET=

# Groq API key for the AI layer. Server-side only, never shipped to the client.
GROQ_API_KEY=

# Port the Express server listens on.
PORT=5000

# Throwaway database used by tests/integration. Integration tests refuse to run
# without it, so they can never delete rows from DATABASE_URL. A Neon dev
# branch is the cheapest option:
#   neon branches create --name dev --parent main
TEST_DATABASE_URL=
